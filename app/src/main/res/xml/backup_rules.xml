<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-backup rules for API 23–30. allowBackup="false" already opts out of
  backup entirely; this file documents the same exclusion explicitly.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
